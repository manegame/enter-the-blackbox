# PocketBase is the deployed phone app's realtime/data backend.
VITE_POCKETBASE_URL=https://pocketbase.example.com

# Public HTTPS base of blackbox-icecast's bridge. The app plays
# /stream/<player-id> continuously after the initial claim tap.
# Leave empty to use cue-triggered MP3 playback only.
VITE_AUDIO_STREAM_BASE=https://audio.example.com
